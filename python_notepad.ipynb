    "\"\"\"\n",
    "Period date tests\n",
    "\"\"\"\n",
    "\n",
    "import calendar\n",
    "\n",
    "\n",
    "def gen_period_date(month_name: str) -> str:\n",
    "    \n",
    "    d = {month: index for index, month in enumerate(calendar.month_abbr) if month}\n",
    "\n",
    "    result = d.get(month_name, None)\n",
    "    \n",
    "    return result\n",
    "    \n",
    "\n",
    "print(gen_period_date(\"December 2024\"))"
   ]
  }
 ],
